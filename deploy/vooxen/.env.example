# Copier en .env (jamais dans Git). Le jeton est généré par la commande 2 du README.
TP_DOMAIN=trends.vooxen.fr
TP_TOKEN=
TP_GEO=FR
TP_SOURCES=google_trends,google_news,wikipedia,reddit
TP_SUBREDDITS=france+vosfinances+entrepreneur_fr
TP_SNAPSHOT_TIME=07:00
TP_DATA_DIR=/opt/vooxen/trend-pulse-data
TP_BACKUP_DIR=/opt/vooxen/trend-pulse-backups
